dados <- read.csv(
text = texto_dados,
stringsAsFactors = FALSE,
check.names = FALSE
)
# A primeira coluna do PDF funciona como numeração das linhas.
rownames(dados) <- dados$row
dados$row <- NULL
# Garante os tipos corretos
dados$dteday <- as.Date(dados$dteday)
dados$instant <- as.integer(dados$instant)
dados$season <- as.integer(dados$season)
dados$weathersit <- as.integer(dados$weathersit)
dados$temp <- as.numeric(dados$temp)
dados$casual <- as.integer(dados$casual)
dados$registered <- as.integer(dados$registered)
# Conferências rápidas
stopifnot(nrow(dados) == 300)
stopifnot(rownames(dados)[1] == "7")
stopifnot(rownames(dados)[300] == "306")
# -----------------------------------------------------------------------------
# 2) Versão visualmente melhorada da tabela
# -----------------------------------------------------------------------------
tabela_formatada <- dados |>
gt(rowname_col = NA) |>
tab_stubhead(label = "linha") |>
tab_header(
title = md("**Espaço amostral completo**"),
subtitle = "Observações 7 a 306"
) |>
cols_label(
instant = "instant",
dteday = "dteday",
season = "season",
weathersit = "weathersit",
temp = "temp",
casual = "casual",
registered = "registered"
) |>
fmt_date(
columns = dteday,
date_style = 3
) |>
fmt_number(
columns = temp,
decimals = 1
) |>
opt_row_striping() |>
tab_options(
table.font.names = c("Arial", "sans-serif"),
table.font.size = px(13),
heading.title.font.size = px(20),
heading.subtitle.font.size = px(13),
column_labels.font.weight = "bold",
column_labels.background.color = "#DCEAF7",
table.border.top.width = px(2),
table.border.bottom.width = px(2),
data_row.padding = px(4)
)
install.packages("openxlsx")
